# Copy to .env and fill in real values. NEVER commit .env.
# No API keys are required for Phase 1 (yfinance is keyless).

# Brokerage (Alpaca PAPER account only)
ALPACA_API_KEY=
ALPACA_SECRET=

# LLM providers
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# News
NEWSAPI_KEY=

# Telegram (a NEW bot, separate from any existing one)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PostgreSQL -- use a SEPARATE database from any existing trading bot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swing_analyzer
DB_USER=
DB_PASSWORD=
